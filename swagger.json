{
    "openapi": "3.0.0",
    "info": {
        "title": "Movieflix API",
        "description": "API responsável por gerenciar os filmes do movieFlix",
        "version": "1.0.0"
    },
    "paths": {
        "/movies": {
            "get": {
                "tags": [
                    "Movie"
                ],
                "summary": "Obter todos os filmes",
                "responses": {
                    "200": {
                        "description": "Em caso de sucesso, ele retorna uma lista de filmes",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Movie"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post":{
                "tags":["Movie"],
                "summary": "Adicionar um filme",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/MovieInput"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Em caso de sucesso, ele adiciona um filme na lista de filmes",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/MovieInput"
                                    }
                                }
                            }
                        }
                    },
                    "409":{
                        "description":"Já existe um filme com o título"
                        
                    },
                    "500":{
                        "description":"Falha ao cadastrar o filme"
                    }
                }
            }
        },
        "/movies/{id}": {
            "put": {
                "tags": [
                    "Movie"
                ],
                "summary": "Atualizar um filme",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "ID do filme a ser atualizado",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/MovieInput"
                            }
                        }
                    }
                },
                "responses":{
                    "200": {
                        "description": "Filme atualizado com sucesso"
                    },
                    "404": {
                        "description": "Filme não encontrado"
                    },
                    "500":{
                        "description": "Falha ao atualizar o registro do filme"
                    }
                }
            },
            "delete": {
                "tags":["Movie"],
                "summary": "Deletar um filme",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "ID do filme a ser removido",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses":{
                    "200": {
                        "description": "Deletado com sucesso"
                    },
                    "404": {
                        "description": "ID inválido - Não existe no banco de dados"
                    },
                    "500":{
                        "description": "Erro do servidor : "
                    }
                }

            }
        },
        "/movies/{genreName}": {
            "get": {
                "tags":["Movie"],
                "summary": "Obter filmes filtrado por gênero",
                "parameters": [
                    {
                        "name": "genreName",
                        "in": "path",
                        "required": true,
                        "description": "Nome do gênero do filme",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Em caso de sucesso, ele retorna uma lista de filmes filtrados por genero",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Movie"
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description":"Genero inexistente"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Movie": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "description": "ID do filme"
                    },
                    "title": {
                        "type": "string",
                        "description": "Título do filme"
                    },
                    "genre": {
                        "type": "object",
                        "description": "Genero do filme",
                        "properties": {
                            "id": {
                                "type": "integer",
                                "description": "ID do genero do filme"
                            },
                            "name": {
                                "type": "string",
                                "description": "Genero do filme"
                            }
                        }
                    },
                    "language_id": {
                        "type": "object",
                        "description": "Idioma do filme",
                        "properties": {
                            "id": {
                                "type": "integer",
                                "description": "ID do idioma do filme"
                            },
                            "name": {
                                "type": "string",
                                "description": "Idioma do filme"
                            }
                        }
                    },
                    "oscar_count": {
                        "type": "integer",
                        "description": "Quantidade de Oscars ganhos pelo filme"
                    },
                    "release_date": {
                        "type": "string",
                        "format": "date",
                        "description": "Data de lançamento do filme"
                    }
                }
            },
            "MovieInput": {
                "type": "object",
                "required": [
                    "title",
                    "genre",
                    "language_id",
                    "oscar_count",
                    "release_date"
                ],
                "properties": {
                    "title":{
                        "type":"string",
                        "description":"Nome do filme"
                    },
                    "genre":{
                        "type":"integer",
                        "description": "Genero do filme"
                    },
                    "language_id":{
                        "type":"integer",
                        "description": "Idioma do filme"
                    }
                    ,"oscar_count":{
                        "type":"integer",
                        "description": "Quantidade de Oscar do filme"
                    }
                    ,"release_date":{
                        "type":"string",
                        "format":"date",
                        "description": "Data de lançamento do filme"
                    }
                }
            }
        }
    }
}